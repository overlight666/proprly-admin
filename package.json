{
  "type": "module",
  "name": "proprly-admin-dashboard",
  "version": "1.0.0",
  "descrption": "proprly admin dashboard",
  "scripts": {
    "build": "yarn typecheck && vite build",
    "dev": "vite --host",
    "format": "prettier --check --ignore-path .gitignore --write .",
    "lint": "eslint --ignore-path .gitignore .",
    "preview": "vite preview --host",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">= 16",
    "npm": ">= 8",
    "yarn": ">= 1"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.17",
    "@fullcalendar/daygrid": "^6.1.17",
    "@fullcalendar/interaction": "^6.1.17",
    "@fullcalendar/react": "^6.1.17",
    "@fullcalendar/timegrid": "^6.1.17",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@hookform/resolvers": "^5.0.1",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-navigation-menu": "^1.2.12",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.11",
    "@szhsin/react-accordion": "^1.4.1",
    "apexcharts": "^3.41.0",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.3.2",
    "clsx": "^2.1.1",
    "datatables.net-dt": "^2.3.0",
    "datatables.net-react": "^1.0.1",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "flowbite": "^1.8.0",
    "flowbite-react": "0.5.0",
    "formik": "^2.4.6",
    "history": "^5.3.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.507.0",
    "moment": "^2.30.1",
    "photoviewer": "^3.10.3",
    "react-apexcharts": "^1.4.1",
    "react-bootstrap": "^2.10.9",
    "react-confirm": "^0.3.0",
    "react-datepicker": "^8.3.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.56.3",
    "react-icons": "^4.10.1",
    "react-loading-overlay-ts": "^2.0.2",
    "react-paginate": "^8.3.0",
    "react-phone-input-2": "^2.15.1",
    "react-select": "^5.10.1",
    "react-signature-canvas": "1.1.0-alpha.2",
    "react-sortablejs": "^6.1.4",
    "react-tailwindcss-datepicker": "1.7.3",
    "react-toastify": "^11.0.5",
    "react-tooltip": "^5.28.1",
    "recoil": "^0.7.7",
    "sortablejs": "^1.15.0",
    "svgmap": "^2.10.1",
    "tailwind-merge": "^3.3.0",
    "use-places-autocomplete": "^4.0.1",
    "xlsx": "^0.18.5",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.17",
    "@types/react-dom": "^18.2.7",
    "@types/sortablejs": "^1.15.1",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^8.9.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-tailwindcss": "^3.13.0",
    "postcss": "^8.4.27",
    "prettier": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^6.14.2",
    "react-router-dom": "^6.14.2",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.1.6",
    "vite": "^4.4.7",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^0.33.0"
  },
  "private": true,
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/strict",
      "plugin:jsx-a11y/recommended",
      "plugin:prettier/recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended",
      "plugin:tailwindcss/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaFeatures": {
        "jsx": true
      },
      "project": "./tsconfig.json"
    },
    "root": true,
    "rules": {
      "@typescript-eslint/consistent-type-imports": "error",
      "react/react-in-jsx-scope": "off",
      "react/no-unescaped-entities": "off",
      "tailwindcss/classnames-order": [
        "error",
        {
          "callees": [
            "classnames"
          ],
          "config": "tailwind.config.cjs"
        }
      ],
      "tailwindcss/no-custom-classname": [
        "error",
        {
          "config": "tailwind.config.cjs"
        }
      ]
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  }
}
